{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustSign",
  "version": "0.3.1",
  "identifier": "com.codesigntool.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RustSign",
        "width": 960,
        "height": 720,
        "center": true,
        "backgroundColor": "#15171e",
        "visible": false,
        "decorations": false,
        "minWidth": 500,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
